{
  "name": "ellaz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ellaz — a cross-device games platform. Play on phone, tablet, and PC.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
